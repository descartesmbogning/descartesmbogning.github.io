---
import Base from '../../layouts/Base.astro';import RecordSearch from '../../components/RecordSearch.astro';import pubs from '../../data/publications.json';
const filters=[...new Set(pubs.map(p=>p.domain))];
---
<Base title="Publications"><div class="page-hero"><div class="container"><p class="eyebrow on-dark">Scholarly outputs</p><h1>Publication archive</h1><p>An initial indexed bibliography covering biomedical discovery, public health and science of science, and patent intelligence. The full Scholar bibliography remains to be reconciled.</p></div></div><section class="section container"><div class="notice" style="margin-bottom:25px">This is not the complete publication list. Entries requiring notice or correction are explicitly identified. Citation counts are intentionally omitted until the full profile can be reconciled.</div><RecordSearch kind="publication records" placeholder="Search publication title, journal, year or topic…" filters={filters}><div class="record-grid">{pubs.map(p=><article class="record" data-record data-categories={p.domain} data-search={`${p.title} ${p.venue} ${p.year} ${p.status} ${p.domain}`}><span class="status">{p.status}</span><h3>{p.title}</h3><p>{p.venue} · {p.year}</p><div><span class="pill">{p.domain}</span></div>{p.url&&<p><a class="arrow" href={p.url} rel="noopener noreferrer">Publication ↗</a></p>}</article>)}</div></RecordSearch><p class="source" style="margin-top:25px">Metadata derived from supplied Google Scholar screenshots. DOI and author-role checks are continuing. For the full changing record, consult <a href="https://scholar.google.com/citations?user=j32BUrIAAAAJ&hl=fr">Google Scholar</a>.</p></section></Base>
