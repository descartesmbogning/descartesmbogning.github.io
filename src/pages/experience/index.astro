---
import Base from '../../layouts/Base.astro';
import exp from '../../data/experience.json';
import quals from '../../data/qualifications.json';
import certs from '../../data/certificates.json';
import skills from '../../data/skills.json';
import profile from '../../data/profile.json';
const cats = [...new Set(certs.map((c) => c.category))];
---
<Base title="Experience & skills" current="/experience/" description="Career, skills with evidence, degrees and certificates of Maxime Descartes Mbogning Fonkou, research and data analyst in Burnaby, BC.">
  <section class="band dots"><div class="wrap"><div class="page-hero">
    <span class="label">Cameroon · France · Canada</span>
    <h1>Experience &amp; skills</h1>
    <p>Ten years of research and analysis, front-line work that built transferable skills, and the degrees and courses behind them.</p>
    <p class="avail-line">{profile.availability} · <a href="/cv/Mbogning-Fonkou-CV.pdf" download>Download CV (PDF)</a></p>
  </div></div></section>
  <section class="section"><div class="wrap">
    <div class="sec-head"><h2>Career</h2></div>
    <ol class="timeline">{exp.jobs.map((j, i) => <li><div class="when">{i === 0 ? <mark>{j.period}</mark> : j.period}</div><div><div class="what">{j.role}</div><div class="where">{j.organisation} · {j.place}</div><p>{j.summary}</p></div></li>)}</ol>
  </div></section>
  <section class="section alt"><div class="wrap">
    <div class="sec-head"><h2>Skills, with proof</h2></div>
    <div class="skills">
      {skills.map((g) => <div><h3>{g.group}</h3><ul>{g.items.map((i) => <li><span class="nm">{i.name}</span><span class="lv">{i.level}</span><span class="pf">{i.url ? <a href={i.url} target="_blank" rel="noopener noreferrer">{i.proof}</a> : i.proof}</span></li>)}</ul></div>)}
    </div>
  </div></section>
  <section class="section"><div class="wrap">
    <div class="sec-head"><h2>Beyond research</h2></div>
    <p class="lede" style="margin-bottom:18px">{exp.beyond.intro}</p>
    <div class="beyond">{exp.beyond.items.map((b) => <div><b>{b.skill}</b><span>{b.where}</span></div>)}</div>
  </div></section>
  <section class="section alt"><div class="wrap">
    <div class="sec-head"><h2>Degrees</h2></div>
    <div class="tablewrap"><table>
      <thead><tr><th>Year</th><th>Degree</th><th>Institution</th></tr></thead>
      <tbody>{quals.map((q) => <tr><td class="yr">{q.year}</td><td><b>{q.url ? <a href={q.url} target="_blank" rel="noopener noreferrer">{q.title}</a> : q.title}</b><div class="source" style="margin-top:4px">{q.detail}</div></td><td>{q.institution}</td></tr>)}</tbody>
    </table></div>
  </div></section>
  <section class="section"><div class="wrap">
    <div class="sec-head"><h2>Certificates</h2><span class="count">{certs.length} courses and certificates</span></div>
    {cats.map((c, i) => (
      <details class="more-list" open={i < 2 || c === 'AI & data'}>
        <summary>{c} ({certs.filter((x) => x.category === c).length})</summary>
        <div class="tablewrap"><table><tbody>
          {certs.filter((x) => x.category === c).map((x) => <tr><td class="yr">{x.year}</td><td><b>{x.title}</b>{x.url && <div class="cert-link"><a href={x.url} target="_blank" rel="noopener noreferrer">{x.url.endsWith('.pdf') ? 'View attestation (PDF)' : x.url.includes('drive.google.com') ? 'View certificate (PDF)' : 'View certificate'} ↗</a></div>}</td><td>{x.issuer}</td></tr>)}
        </tbody></table></div>
      </details>))}
  </div></section>
</Base>
