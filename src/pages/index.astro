---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import domains from '../data/domains.json';
import certs from '../data/certificates.json';
import publications from '../data/publications.json';
---
<Base><div class="hero"><div class="container hero-inner"><div class="eyebrow on-dark">The scientific contributions archive</div><h1>From <span class="accent">biomedical discovery</span> to understanding science itself.</h1><p>{profile.intro}</p><div class="actions"><a class="btn" href="/research/">Explore research domains ↗</a><a class="btn outline" href="/projects/">Browse all contributions</a><a class="btn outline" href="/credentials/">Degrees & certificates</a></div><div class="stats"><div class="stat"><strong>{domains.length}</strong><span>Interconnected research domains</span></div><div class="stat"><strong>{projects.length}</strong><span>Documented project areas</span></div><div class="stat"><strong>{publications.length}</strong><span>Initial indexed publications*</span></div><div class="stat"><strong>{certs.length}</strong><span>Training & certificate entries</span></div></div><p class="mini" style="margin-top:15px;color:#9fcad0">*The publication catalogue is a growing, source-checked subset; it is not yet a complete bibliography.</p></div></div>
<section class="section container"><p class="eyebrow">An interconnected body of work</p><h2>Explore the research domains</h2><p class="lede">Scientific contributions grouped by subject, not by a small selection of showcase projects. Many projects connect several domains.</p><div class="grid">{domains.map((d,i)=><a class="card" href={`/research/${d.id}/`}><span class="num">0{i+1}</span><h3>{d.label} →</h3><p>{d.desc}</p><span class="arrow">Explore {projects.filter(p=>p.domains.includes(d.id)).length} related project areas ↗</span></a>)}</div></section>
<section class="section section-tint"><div class="container"><p class="eyebrow">The research journey</p><h2>From the laboratory to data-driven intelligence</h2><div class="timeline"><div class="timeline-item"><h3>Experimental biomedical research</h3><p>Culturomics, bacterial discovery, microbiome studies, and collaborative cancer immunotherapy research.</p></div><div class="timeline-item"><h3>Bibliometrics, epidemiology & science of science</h3><p>Research patterns, inequalities, funding, collaboration, open access and African public health research.</p></div><div class="timeline-item"><h3>Technology & patent intelligence</h3><p>Patent landscaping, topic models, network analysis, innovation actors and emerging technology landscapes.</p></div><div class="timeline-item"><h3>Research metadata engineering & applied AI</h3><p>Cross-source data integration, preprint metadata pipelines, research applications and LLM-assisted evidence workflows.</p></div></div><a class="btn teal" href="/about/">Read the research story →</a></div></section>
<section class="section container"><div class="sides"><div><p class="eyebrow">Explore every contribution</p><h2>Research, tools, outputs and evidence — together.</h2><p class="lede">Search a complete working inventory, then follow connections to peer-reviewed publications, GitHub repositories, datasets, software applications and training.</p><div class="actions"><a class="btn teal" href="/projects/">All {projects.length} project areas ↗</a><a class="btn teal" href="/publications/">Publication catalogue ↗</a></div></div><div class="card"><p class="eyebrow">Professional development</p><h3>Degrees, certifications and continuing education</h3><p>Academic diplomas are distinguished from specialized and short-course certificates. Files remain private unless independently approved for publication.</p><a class="arrow" href="/credentials/">Explore the credentials archive ↗</a></div></div></section>
<section class="section section-tint"><div class="container"><p class="eyebrow">Collaborate & connect</p><h2>Working across disciplines</h2><p class="lede">For scientific collaborations, data science and research intelligence opportunities, technology landscaping, and evidence-oriented research partnerships.</p><div class="actions"><a class="btn teal" href={profile.linkedin}>Connect on LinkedIn ↗</a><a class="btn teal" href={profile.github}>Explore GitHub ↗</a><a class="btn teal" href={profile.scholar}>Google Scholar ↗</a></div></div></section></Base>
