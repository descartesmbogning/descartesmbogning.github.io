---
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/CaseStudy.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import exp from '../data/experience.json';
import skills from '../data/skills.json';
const featured = projects.filter((p) => p.featured).sort((a, b) => a.featured - b.featured);
---
<Base current="/">
  <section class="band dots">
    <div class="wrap">
      <div class="hero">
        <span class="label">{profile.location}</span>
        <h1>{profile.name}</h1>
        <div class="headline">{profile.headline} · {profile.specialties}</div>
        <p class="avail">{profile.availability}</p>
        <p class="lead">{profile.summary}</p>
        <div class="facts"><span>{profile.languages}</span></div>
        <div class="btns">
          <a class="btn" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn ghost" href="/cv/Mbogning-Fonkou-CV.pdf" download>Download CV</a>
        </div>
      </div>
      <div class="metrics">{profile.metrics.map((m) => <div class="metric"><b>{m.value}</b><span>{m.label}</span></div>)}</div>
      <p class="source" style="padding-bottom:28px;position:relative;z-index:1">Counts from the <a href={profile.metricsSourceUrl}>{profile.metricsSource}</a>.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head"><h2>Selected work</h2><a class="more" href="/projects/">All {projects.length} projects →</a></div>
      <div class="cases">{featured.map((p) => <CaseStudy p={p} />)}</div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="sec-head"><h2>Experience</h2><a class="more" href="/experience/">Full experience and credentials →</a></div>
      <ol class="timeline">
        {exp.jobs.slice(0, 5).map((j, i) => <li><div class="when">{i === 0 ? <mark>{j.period}</mark> : j.period}</div><div><div class="what">{j.role}</div><div class="where">{j.organisation} · {j.place}</div><p>{j.summary}</p></div></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head"><h2>Skills, with proof</h2></div>
      <div class="skills">
        {skills.map((g) => <div><h3>{g.group}</h3><ul>{g.items.map((i) => <li><span class="nm">{i.name}</span><span class="lv">{i.level}</span><span class="pf">{i.url ? <a href={i.url} target="_blank" rel="noopener noreferrer">{i.proof}</a> : i.proof}</span></li>)}</ul></div>)}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="sec-head"><h2>Beyond research</h2></div>
      <p class="lede" style="margin-bottom:18px">{exp.beyond.intro}</p>
      <div class="beyond">{exp.beyond.items.map((b) => <div><b>{b.skill}</b><span>{b.where}</span></div>)}</div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <div class="contact">
        <h2>Hiring, or need research intelligence?</h2>
        <p>Write to me about research-evaluation, data-analysis or public-service roles, or about a publication, patent or funding landscape for your team. I reply in English or French.</p>
        <a class="email" id="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="contact-actions"><button class="copy" type="button" data-copy={profile.email}>Copy email address</button><a class="copy" href="/cv/Mbogning-Fonkou-CV.pdf" download>Download CV (PDF, 2 pages)</a></div>
        <div class="links">{profile.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}</div>
      </div>
    </div>
  </section>
</Base>
<script>
  for (const b of document.querySelectorAll('[data-copy]')) b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'Copied'; }
    catch { const r = document.createRange(); r.selectNodeContents(document.getElementById('email')); const s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = 'Press Ctrl+C to copy'; }
  });
</script>
