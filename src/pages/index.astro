---
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/CaseStudy.astro';
import profile from '../data/profile.json';
import projects from '../data/projects.json';
import { programmeList } from '../lib/programmes.js';
import species from '../data/species.json';
import pubs from '../data/publications.json';
const metrics = [
  { value: String(species.length), label: 'bacterial species described', href: '/species/' },
  { value: String(pubs.length), label: 'publications, from Nature Biotechnology to Science', href: '/publications/' },
  ...profile.metrics,
];
const featured = projects.filter((p) => p.featured).sort((a, b) => a.featured - b.featured);
---
<Base current="/">
  <section class="band dots">
    <div class="wrap">
      <div class="hero">
        <span class="label">{profile.location}</span>
        <h1>{profile.name}</h1>
        <div class="headline">{profile.headline} · {profile.specialties}</div>
        <p class="lead">{profile.summary}</p>
        <div class="facts"><span>{profile.languages}</span></div>
        <div class="btns">
          <a class="btn" href={`mailto:${profile.email}`}>Email me</a>
          <a class="btn ghost" href="/cv/Mbogning-Fonkou-CV.pdf" download>Download CV</a>
        </div>
      </div>
      <div class="metrics" style="padding-bottom:28px">{metrics.map((m) => m.href ? <a class="metric" href={m.href}><b>{m.value}</b><span>{m.label}</span></a> : <div class="metric"><b>{m.value}</b><span>{m.label}</span></div>)}</div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap about-home">
      <div class="sec-head"><h2>About me</h2></div>
      <div class="story">{profile.about.map((t) => typeof t === 'string' ? <p set:html={t} /> : <><h3>{t.heading}</h3><p set:html={t.text} /></>)}</div>
      <div>
        <h3 class="label" style="margin-bottom:10px">What my work helps answer</h3>
        <ul class="tags">{programmeList.filter((g) => g.id !== 'tools').map((g) => <li><a href={`/projects/#${g.id}`}>{g.title}</a></li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="sec-head"><h2>Selected work</h2><a class="more" href="/projects/">All {projects.length} projects →</a></div>
      <div class="cases">{featured.map((p) => <CaseStudy p={p} />)}</div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="sec-head"><h2>Find out more</h2></div>
      <div class="next">
        <a href="/projects/"><b>Projects →</b><span>All {projects.length} studies, datasets and tools, grouped by the question they answer.</span></a>
        <a href="/publications/"><b>Publications →</b><span>Articles, preprints and thesis, with links to each paper.</span></a>
        <a href="/species/"><b>Bacteria I described →</b><span>35 new species and 5 new genera from culturomics, with LPSN links.</span></a>
        <a href="/experience/"><b>Experience &amp; skills →</b><span>Career, skills with proof, degrees and certificates.</span></a>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="wrap">
      <div class="contact">
        <h2>How I can help</h2>
        <ul class="routes">
          <li><b>Research landscapes and gap analysis</b></li>
          <li><b>Patent and technology landscapes</b></li>
          <li><b>Funding, portfolio and equity analysis</b></li>
          <li><b>Faster evidence with AI, checked by people</b></li>
        </ul>
        <p>I work through my Canadian company, CognosX, in English and French, and can work under a confidentiality agreement. Small first projects are welcome. Looking for a staff role? My CV is below.</p>
        <a class="email" id="email" href={`mailto:${profile.email}`}>{profile.email}</a>
        <div class="contact-actions"><button class="copy" type="button" data-copy={profile.email}>Copy email address</button><a class="copy" href="/cv/Mbogning-Fonkou-CV.pdf" download>Download CV (PDF, 2 pages)</a></div>
        <div class="links">{profile.links.map((l) => <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label} ↗</a>)}</div>
      </div>
    </div>
  </section>
</Base>
<script>
  for (const b of document.querySelectorAll('[data-copy]')) b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = 'Copied'; }
    catch { const r = document.createRange(); r.selectNodeContents(document.getElementById('email')); const s = getSelection(); s.removeAllRanges(); s.addRange(r); b.textContent = 'Press Ctrl+C to copy'; }
  });
</script>
