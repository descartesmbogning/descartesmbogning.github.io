---
import profile from '../data/profile.json';
import projects from '../data/projects.json';
const base = import.meta.env.BASE_URL;
const categories = [...new Set(projects.map(p => p.category))];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={profile.intro}/><title>{profile.name} — Research Portfolio</title><style>
:root{font-family:Inter,system-ui,-apple-system,sans-serif;color:#183047;background:#f5f8fb}*{box-sizing:border-box}body{margin:0}a{color:#176a97}header{background:#102b42;color:white;padding:22px max(5vw,20px)}nav{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}nav a{color:#e3f0fb;text-decoration:none;margin-left:15px}.wrap{max-width:1120px;margin:auto;padding:0 24px}.hero{padding:92px 0 68px;background:linear-gradient(120deg,#102b42,#1a5675);color:#fff}.eyebrow{color:#b2d9e9;font-weight:700;letter-spacing:.14em;text-transform:uppercase;font-size:12px}h1{font-size:clamp(32px,5vw,60px);line-height:1.08;max-width:900px;margin:18px 0}h2{font-size:32px}.hero p{font-size:19px;max-width:760px;line-height:1.7;color:#e0edf5}.links{display:flex;gap:12px;flex-wrap:wrap;margin-top:25px}.button{display:inline-block;background:#fff;color:#103a55;padding:12px 17px;border-radius:8px;text-decoration:none;font-weight:700}.button.alt{background:transparent;border:1px solid #b3cdda;color:white}section{padding:62px 0}.muted{color:#506579;line-height:1.65}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px}.card{background:#fff;border:1px solid #dce6ef;border-radius:14px;padding:26px;box-shadow:0 8px 25px #1730470b}.tag{display:inline-block;background:#e7f2f8;color:#1c5e7f;padding:6px 10px;border-radius:30px;font-size:12px;font-weight:700}.card h3{font-size:21px;margin:17px 0 10px}.card p{line-height:1.6}.small{font-size:13px;color:#60778a}.methods{display:flex;gap:6px;flex-wrap:wrap;margin:14px 0}.methods span{font-size:12px;padding:5px 8px;border-radius:6px;background:#f0f3f7}.filter{display:flex;gap:8px;flex-wrap:wrap;margin:20px 0 28px}.filter button{border:1px solid #b5ccda;border-radius:20px;background:white;padding:8px 14px;cursor:pointer}.filter button.active{background:#153d56;color:white}footer{background:#102b42;color:#d6e7f0;padding:35px 0}footer a{color:#c0e7ff}
</style></head><body><header><nav class="wrap"><strong>{profile.name}</strong><div><a href="#projects">Projects</a><a href="#about">About</a><a href="#contact">Contact</a></div></nav></header><div class="hero"><div class="wrap"><div class="eyebrow">Research • Data • Technology Intelligence</div><h1>{profile.headline}</h1><p>{profile.intro}</p><div class="links"><a class="button" href="#projects">Explore projects</a><a class="button alt" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a class="button alt" href={profile.scholar} target="_blank" rel="noopener noreferrer">Google Scholar ↗</a></div></div></div><main><section class="wrap" id="projects"><div class="eyebrow">Selected work</div><h2>Projects & case studies</h2><p class="muted">Published research, working software, and ongoing research are labelled separately. Edit <code>src/data/projects.json</code> to update this section.</p><div class="filter"><button data-filter="All" class="active">All</button>{categories.map(c=><button data-filter={c}>{c}</button>)}</div><div class="grid">{projects.map(p=><article class="card" data-category={p.category}><span class="tag">{p.category}</span><p class="small">{p.status}</p><h3><a href={`${base}projects/${p.slug}/`}>{p.title}</a></h3><p>{p.summary}</p><div class="methods">{p.methods.map(m=><span>{m}</span>)}</div><a href={`${base}projects/${p.slug}/`}>Read case study →</a></article>)}</div></section><section id="about" style="background:#eaf1f6"><div class="wrap"><div class="eyebrow">About</div><h2>From biomedical research to research intelligence</h2><p class="muted">My background spans experimental microbiology, bibliometrics, patent analysis, scientific data engineering, and applied AI. I develop reproducible workflows to turn complex research records into interpretable evidence.</p></div></section><section id="contact" class="wrap"><div class="eyebrow">Connect</div><h2>Research, collaboration & opportunities</h2><p class="muted">Based in {profile.location}. For research, data science, and technology intelligence opportunities, connect through the links below.</p><div class="links"><a href={profile.linkedin}>LinkedIn ↗</a><a href={profile.github}>GitHub ↗</a><a href={profile.scholar}>Google Scholar ↗</a>{profile.email&&<a href={`mailto:${profile.email}`}>Email ↗</a>}</div></section></main><footer><div class="wrap">© {new Date().getFullYear()} {profile.name}. Built with Astro and GitHub Pages.</div></footer><script>document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('[data-category]').forEach(x=>x.hidden=b.dataset.filter!=='All'&&x.dataset.category!==b.dataset.filter)}));</script></body></html>
