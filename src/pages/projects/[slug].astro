---
import Base from '../../layouts/Base.astro';import projects from '../../data/projects.json';import domains from '../../data/domains.json';
export function getStaticPaths(){return projects.map(p=>({params:{slug:p.slug},props:{p}}));}
const {p}=Astro.props;
---
<Base title={p.title} description={p.summary}><div class="page-hero"><div class="container"><div class="breadcrumb"><a href="/projects/" style="color:#a3cbd1">All projects</a> / {p.id}</div><p class="eyebrow on-dark">{p.status}</p><h1>{p.title}</h1><p>{p.summary}</p><div>{p.domains.map(id=><span class="pill dark">{domains.find(d=>d.id===id)?.label}</span>)}</div></div></div><div class="container detail"><div class="notice">This entry belongs to an evolving research archive. The evidence and verification notes below explain what has been documented and what remains to be confirmed.</div><h2>Research question / objective</h2><p>{p.summary}</p><div class="detail-line"><strong>Documented / provisional contribution</strong><p>{p.contribution}</p></div><div class="detail-line"><strong>Methods, software and data sources</strong><div class="skill-list">{p.methods.map(x=><span class="pill">{x}</span>)}</div></div><div class="detail-line"><strong>Skills demonstrated</strong><div class="skill-list">{p.skills.map(x=><span class="pill">{x}</span>)}</div></div><div class="detail-line"><strong>Outputs</strong><p>{p.outputs}</p></div><div class="detail-line"><strong>Evidence</strong><p class="source">{p.evidenceType}</p><div class="linkline">{p.links.map(l=><a href={l.url} target="_blank" rel="noreferrer">{l.label} ↗</a>)}</div></div><div class="detail-line"><strong>What still needs verification</strong><p>{p.verification}</p></div><div style="margin-top:30px"><a href="/projects/">← All projects</a></div></div></Base>
