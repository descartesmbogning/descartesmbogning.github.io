---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Filter from '../../components/Filter.astro';
import projects from '../../data/projects.json';
import domains from '../../data/domains.json';
const statuses = ['Published', 'In preparation', 'Software & data', 'Ongoing work'];
const groups = [
  { key: 'areas', label: 'Area', options: domains.map((d) => ({ value: d.id, label: d.label })) },
  { key: 'status', label: 'Status', options: statuses.map((s) => ({ value: s, label: s })) },
];
---
<Base title="Projects" current="/projects/" description="Research, data and software projects in bibliometrics, patent analytics, public health and microbiology.">
  <section class="band dots"><div class="wrap"><div class="page-hero">
    <span class="label">{projects.length} projects · 6 research areas</span>
    <h1>Projects</h1>
    <p>Research studies, datasets and software tools, from microbial discovery to science-of-science and patent intelligence. The strongest work is listed first.</p>
  </div></div></section>
  <section class="section"><div class="wrap">
    <Filter groups={groups} placeholder="Search projects, methods or tools" noun="projects" />
    <div class="cards">{projects.map((p) => <ProjectCard p={p} domains={domains} />)}</div>
  </div></section>
</Base>
