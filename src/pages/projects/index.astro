---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import Filter from '../../components/Filter.astro';
import projects from '../../data/projects.json';
import { programmeList, areaToProgramme, oldProgramme } from '../../lib/programmes.js';
const statuses = ['Published', 'Preprint', 'Manuscript in preparation', 'In progress', 'Client project', 'Tool or dataset', 'Talk or article'];
const kinds = ['Review', 'Bibliometric analysis', 'Patent analysis', 'Funding analysis', 'AI-assisted screening', 'Epidemiology', 'Lab research', 'Tool'];
const opts = (l) => l.map((s) => ({ value: s, label: s }));
const groups = [{ key: 'kind', label: 'Method', options: opts(kinds) }, { key: 'role', label: 'My role', options: opts(['Lead', 'Contributor']) }, { key: 'status', label: 'Status', options: opts(statuses) }];
const textOf = (p) => `${p.title} ${p.summary} ${p.methods.join(' ')} ${p.skills.join(' ')}`.toLowerCase();
---
<Base title="Projects" current="/projects/" description="Research grouped by the question it helps answer: where a field is going, what the evidence says, who is left out, and whether the evidence is keeping up.">
  <section class="band dots"><div class="wrap"><div class="page-hero">
    <span class="label">{projects.length} projects · grouped by the question they answer</span>
    <h1>Projects</h1>
    <p>My work, grouped by the question it helps answer: where a field is going, what the evidence says, who is left out, and whether the evidence is keeping up. Filter by method to see every review or bibliometric study, whether I led it or contributed to it.</p>
  </div></div></section>
  <section class="section"><div class="wrap">
    <nav class="prog-nav" aria-label="Questions">
      {programmeList.map((g) => <a href={`#${g.id}`}>{g.title}<span>{g.all.length}</span></a>)}
    </nav>
    <Filter groups={groups} placeholder="Search projects, tools or skills" noun="projects" />
    {programmeList.map((g, i) => (
      <div class="programme" id={g.id} data-programme>
        <div class="prog-head">
          <span class="label">{g.label} · {g.all.length} {g.all.length === 1 ? 'project' : 'projects'}</span>
          <h2>{g.title}</h2>
          <p class="prog-q">{g.question}</p>
          <p class="lede">{g.summary}</p>
          <div class="prog-tags">
            <div><h3 class="label">Tools used</h3><ul class="tags counted">{g.tools.slice(0, 14).map((t) => <li>{t.name}{t.n > 1 && <b>×{t.n}</b>}</li>)}</ul></div>
            <div><h3 class="label">Skills</h3><ul class="tags counted">{g.skills.slice(0, 12).map((t) => <li>{t.name}{t.n > 1 && <b>×{t.n}</b>}</li>)}</ul></div>
          </div>
          {g.extra && <a class="more" href={g.extra.url}>{g.extra.label} →</a>}
        </div>
        {g.leadProject && <div class="prog-lead" data-item data-status={g.leadProject.status} data-kind={(g.leadProject.kind || []).join('|')} data-role={g.leadProject.role} data-text={textOf(g.leadProject)}><CaseStudy p={g.leadProject} /></div>}
        {g.memberProjects.length > 0 && <>
          {g.leadProject && <h3 class="prog-sub">Also in this group</h3>}
          <div class="cards">{g.memberProjects.map((p) => <ProjectCard p={p} />)}</div>
        </>}
      </div>))}
  </div></section>
</Base>
<script define:vars={{ areaToProgramme, oldProgramme }}>
  // Hide a programme when the filter leaves none of its projects visible.
  const sync = () => {
    for (const g of document.querySelectorAll('[data-programme]')) {
      g.hidden = ![...g.querySelectorAll('[data-item]')].some((it) => !it.hidden);
    }
  };
  document.addEventListener('filtered', sync);
  const m = location.hash.match(/^#area-([a-z-]+)$/);
  if (m && areaToProgramme[m[1]]) { history.replaceState(null, '', `#${areaToProgramme[m[1]]}`); document.getElementById(areaToProgramme[m[1]])?.scrollIntoView(); }
  const o = location.hash.slice(1);
  if (oldProgramme[o]) { history.replaceState(null, '', `#${oldProgramme[o]}`); document.getElementById(oldProgramme[o])?.scrollIntoView(); }
</script>
