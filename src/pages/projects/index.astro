---
import Base from '../../layouts/Base.astro';import RecordSearch from '../../components/RecordSearch.astro';import projects from '../../data/projects.json';import domains from '../../data/domains.json';
---
<Base title="All projects"><div class="page-hero"><div class="container"><p class="eyebrow on-dark">Complete working project index</p><h1>All research & software projects</h1><p>{projects.length} inventoried project areas, grouped through six interconnected domains. Projects, prototypes and published work are labelled by status.</p></div></div><section class="section container"><RecordSearch kind="projects" placeholder="Search projects, tools, questions and outputs…" filters={domains.map(d=>d.label)}><div class="record-grid">{projects.map(p=><article class="record" data-record data-categories={p.domains.map(id=>domains.find(x=>x.id===id)?.label).join('|')} data-search={`${p.title} ${p.summary} ${p.status} ${p.methods.join(' ')} ${p.outputs} ${p.skills.join(' ')}`}><span class="status">{p.status}</span><h3><a href={`/projects/${p.slug}/`}>{p.title} ↗</a></h3><p>{p.summary}</p><div>{p.domains.map(id=><span class="pill">{domains.find(x=>x.id===id)?.label}</span>)}</div></article>)}</div></RecordSearch></section></Base>
