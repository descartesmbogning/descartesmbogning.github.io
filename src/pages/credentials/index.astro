---
import Base from '../../layouts/Base.astro';import RecordSearch from '../../components/RecordSearch.astro';import quals from '../../data/qualifications.json';import certs from '../../data/certificates.json';
const cats=[...new Set(certs.map(x=>x.category))];
---
<Base title="Academic qualifications & certificates"><div class="page-hero"><div class="container"><p class="eyebrow on-dark">Education & professional development</p><h1>Qualifications & certificates</h1><p>Academic degrees, professional credentials, continuing education and specialized courses, grouped transparently and supported by the original records where available.</p></div></div><section class="section container"><p class="eyebrow">Formal academic qualifications</p><h2>Degrees & academic recognition</h2><div class="grid">{quals.map(q=><article class="card degree"><p class="meta">{q.year}</p><h3>{q.title}</h3><p><strong>{q.institution}</strong></p><p>{q.field}</p><p>{q.detail}</p><p class="source">Evidence: {q.evidence}</p></article>)}</div><p class="source" style="margin-top:14px">Original diplomas and transcripts are not embedded on this public website. Some additional academic details are awaiting direct document verification.</p></section><section class="section section-tint"><div class="container"><p class="eyebrow">Continuous learning</p><h2>Certificates & professional development</h2><p class="lede">This full working list includes specialized courses, professional training and verified achievements, with overlapping LinkedIn entries retained for reconciliation.</p><RecordSearch kind="credential entries" placeholder="Search training, institution, skill or year…" filters={cats}><div class="record-grid">{certs.map(c=><article class="record" data-record data-categories={c.category} data-search={`${c.title} ${c.issuer} ${c.year} ${c.category}`}><p class="meta">{c.year} · {c.category}</p><h3>{c.title}</h3><p><strong>{c.issuer}</strong></p><p class="source">Source: {c.evidence}</p>{c.note&&<p class="source">{c.note}</p>}{c.url&&<a class="arrow" href={c.url} rel="noreferrer noopener">Verify credential ↗</a>}</article>)}</div></RecordSearch></div></section></Base>
