---
const { p } = Astro.props;
---
<article class="card" data-item data-status={p.status}
  data-text={`${p.title} ${p.summary} ${p.methods.join(' ')} ${p.skills.join(' ')}`.toLowerCase()}>
  <span class="status" data-s={p.status}>{p.status}</span>
  <h3><a href={`/projects/${p.slug}/`}>{p.title}</a></h3>
  <p>{p.summary}</p>
  {p.methods.length > 0 && <ul class="tags mini" aria-label="Tools">{p.methods.slice(0, 4).map((m) => <li>{m}</li>)}</ul>}
  {p.links.find((l) => l.url.includes('github.com')) && <a class="gh" href={p.links.find((l) => l.url.includes('github.com')).url} target="_blank" rel="noopener noreferrer">Code on GitHub ↗</a>}
</article>
