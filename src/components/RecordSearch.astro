---
const {kind='records',placeholder='Search records…',filters=[]}=Astro.props;
---
<div data-search-container><input class="search" type="search" aria-label={`Search ${kind}`} placeholder={placeholder} data-search-input/><div class="filters"><button class="filter-btn active" type="button" data-filter="all" aria-pressed="true">All</button>{filters.map(c=><button type="button" class="filter-btn" data-filter={c} aria-pressed="false">{c}</button>)}</div><p class="results" aria-live="polite"><span data-count></span> {kind} shown</p><slot/><p class="empty" data-empty>No records match. Try another keyword or filter.</p></div>
<script>
document.querySelectorAll('[data-search-container]').forEach(el=>{
 const input=el.querySelector('[data-search-input]');const buttons=[...el.querySelectorAll('[data-filter]')];let filter='all';const items=[...el.querySelectorAll('[data-record]')];
 const update=()=>{const q=(input.value||'').trim().toLocaleLowerCase();let count=0;for(const item of items){const cats=(item.dataset.categories||'').split('|');const found=(item.dataset.search||item.textContent||'').toLocaleLowerCase().includes(q);const ok=(filter==='all'||cats.includes(filter))&&found;item.hidden=!ok;if(ok)count++;}el.querySelector('[data-count]').textContent=String(count);el.querySelector('[data-empty]').style.display=count?'none':'block';};
 input.addEventListener('input',update);for(const b of buttons)b.addEventListener('click',()=>{filter=b.dataset.filter;buttons.forEach(x=>{x.classList.toggle('active',x===b);x.setAttribute('aria-pressed',String(x===b));});update();});update();
});
</script>
