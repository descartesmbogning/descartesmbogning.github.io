---
import profile from '../data/profile.json';
import '../styles/global.css';
const {title,description=profile.intro}=Astro.props;
const nav=[['/','Home'],['/research/','Research'],['/projects/','All projects'],['/publications/','Publications'],['/credentials/','Credentials'],['/methods/','Methods'],['/about/','About']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#082b3b"/><title>{title ? `${title} · ${profile.name}` : `${profile.name} · Research archive`}</title></head><body><a class="skip" href="#main">Skip to content</a><header class="site-header"><div class="container nav-inner"><a class="brand" href="/">{profile.name}<small>Scientific contributions archive</small></a><nav class="nav-links" aria-label="Primary navigation">{nav.map(([url,label])=><a href={url}>{label}</a>)}</nav></div></header><main id="main"><slot/></main><footer class="footer"><div class="container footer-cols"><div><strong>{profile.name}</strong><p>Biomedical research · Science of science · Research intelligence</p><small>© {new Date().getFullYear()} · Built with Astro · Updated through GitHub</small></div><div class="linkline"><a href={profile.github} rel="noopener noreferrer">GitHub ↗</a><a href={profile.scholar} rel="noopener noreferrer">Google Scholar ↗</a><a href={profile.linkedin} rel="noopener noreferrer">LinkedIn ↗</a></div></div></footer></body></html>
